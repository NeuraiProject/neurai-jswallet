{
  "name": "@neuraiproject/neurai-jswallet",
  "version": "0.16.0",
  "description": "Neurai JavaScript wallet library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/entries/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/entries/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/entries/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./global": "./dist/NeuraiJsWallet.global.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rollup -c rollup.config.mjs && rollup -c rollup.dts.config.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "test": "npm run build && mocha ./src/tests && npm run test:types",
    "test:types": "tsc -p tsconfig.types.json && tsc -p tsconfig.types-node16.json && tsc -p tsconfig.types-bundler.json",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:run": "mocha ./src/tests",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-jswallet.git"
  },
  "keywords": [
    "Neurai"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neuraiproject/neurai-jswallet/issues"
  },
  "dependencies": {
    "@neuraiproject/neurai-assets": "^1.7.2",
    "@neuraiproject/neurai-create-transaction": "^0.9.1",
    "@neuraiproject/neurai-key": "^5.0.2",
    "@neuraiproject/neurai-rpc": "^0.6.1",
    "@neuraiproject/neurai-scripts": "^0.9.1",
    "@neuraiproject/neurai-sign-transaction": "^3.0.0"
  },
  "homepage": "https://github.com/neuraiproject/neurai-jswallet#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^20.8.0",
    "chai": "^4.3.10",
    "mocha": "^11.7.5",
    "rollup": "^4.52.4",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^9.0.0"
  }
}
